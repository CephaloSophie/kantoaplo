{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kantoaplo.dev/schema/domino/2.json",
  "title": "Projet Zeugma",
  "type": "object",
  "required": [
    "format",
    "version",
    "parties"
  ],
  "properties": {
    "format": {
      "const": "kantoaplo.domino"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "editor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "name": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "description": "Valeurs du contexte, lues par les liaisons { \"$bind\": \"clé\" } et les gabarits {{clé}}."
    },
    "assets": {
      "type": "object",
      "description": "Ressources du projet : des documents JSON attachés ou importés (une collection d’API, des environnements, un jeu de données…), par clé. Le langage les lit ; sa boîte à outils peut en tirer des pierres.",
      "additionalProperties": true
    },
    "parties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/partie"
      }
    },
    "wires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wire"
      },
      "description": "Fils : d’un point de sortie à un point d’entrée, entre deux pierres de la même partie."
    }
  },
  "$defs": {
    "partie": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "main",
            "declarations",
            "body",
            "component"
          ],
          "description": "main : la partie principale ; declarations : classes, bibliothèques, fonctions ; body : le corps d’une déclaration ; component : la sous-partie d’une pierre conteneur."
        },
        "owner": {
          "type": "string",
          "description": "Pierre (conteneur ou déclaration) qui ouvre cette partie."
        },
        "dominos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/domino"
          }
        }
      }
    },
    "domino": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "description": "Têtes de chaîne et pierres libres seulement."
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {},
              {
                "$ref": "#/$defs/binding"
              },
              {
                "$ref": "#/$defs/ref"
              }
            ]
          }
        },
        "turn": {
          "enum": [
            "right",
            "down",
            "left",
            "up",
            "straight"
          ]
        },
        "top": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adjacent"
          },
          "description": "Adjacentes hautes : chacune alimente l’entrée n° pip."
        },
        "bottom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adjacent"
          },
          "description": "Adjacentes basses : chacune consomme la sortie n° pip."
        },
        "next": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          },
          "description": "Suite de la chaîne : la sortie n° pip mène à la pierre suivante."
        },
        "note": {
          "type": "string",
          "description": "Note de l’utilisateur."
        },
        "disabled": {
          "type": "boolean",
          "description": "Neutralisée : l’effet domino la traverse sans l’exécuter."
        },
        "locked": {
          "type": "boolean",
          "description": "Verrouillée pour l’utilisateur."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "meta": {
          "type": "object"
        },
        "trace": {
          "$ref": "#/$defs/trace"
        }
      }
    },
    "adjacent": {
      "type": "object",
      "required": [
        "pip",
        "domino"
      ],
      "properties": {
        "pip": {
          "type": "integer",
          "minimum": 0
        },
        "domino": {
          "$ref": "#/$defs/domino"
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "pip",
        "domino"
      ],
      "properties": {
        "pip": {
          "type": "integer",
          "minimum": 0
        },
        "map": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Entrées de la pierre suivante câblées sur cette sortie."
        },
        "label": {
          "type": "string"
        },
        "cond": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ],
          "description": "Condition : expression JavaScript courte (texte) ou expression déclarative (objet, voir expr.schema.json)."
        },
        "enabled": {
          "type": "boolean"
        },
        "domino": {
          "$ref": "#/$defs/domino"
        }
      }
    },
    "wire": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/end",
          "description": "Point de sortie (face droite)."
        },
        "to": {
          "$ref": "#/$defs/end",
          "description": "Point d’entrée (face gauche)."
        },
        "blocking": {
          "type": "boolean",
          "description": "false : l’appelant n’attend pas (appel non bloquant). Absent : bloquant."
        },
        "type": {
          "type": "string",
          "description": "Genre de lien (langage : edges) : transition, relation…"
        },
        "fields": {
          "type": "object",
          "description": "Champs du lien (événement, garde, cardinalité…)."
        },
        "label": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "meta": {
          "type": "object"
        },
        "trace": {
          "$ref": "#/$defs/trace"
        }
      }
    },
    "end": {
      "type": "object",
      "required": [
        "domino",
        "pip"
      ],
      "properties": {
        "domino": {
          "type": "string"
        },
        "pip": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "description": "Nom du point (lecture seule, pour les générateurs)."
        }
      }
    },
    "binding": {
      "type": "object",
      "required": [
        "$bind"
      ],
      "properties": {
        "$bind": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ref": {
      "type": "object",
      "required": [
        "$ref"
      ],
      "properties": {
        "$ref": {
          "type": "string",
          "description": "Identifiant d’une pierre, d’une partie, d’une déclaration ou d’une variable."
        }
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "description": "Provenance.",
      "properties": {
        "created": {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "by": {
              "type": "string"
            },
            "how": {
              "type": "string",
              "description": "pioche, ajout rapide, copie, import, api…"
            },
            "from": {
              "type": "string",
              "description": "L’original d’une copie."
            }
          }
        },
        "modified": {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "by": {
              "type": "string"
            },
            "count": {
              "type": "integer"
            },
            "last": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
